{
	"schemaVersion": 1,
	"id": "additions",
	"version": "${version}",
	"name": "DayOfMind Additions",
	"description": "DayOfMind is a mod that adds new blocks, recipes and features. With unique lanterns, expanded block variations and clever features like switching grass and dirt paths with a shovel, DayOfMind offers exciting possibilities for your adventures.",
	"authors": [
		"LufatZ",
		"OxFaTech Team"
	],
	"contact": {
		"homepage": "https://oxfatech.de",
		"sources": "https://github.com/LufatZ/DOMAdditions/"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/additions/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "de.additions.Additions",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "de.additions.AdditionsClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "de.additions.AdditionsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.additions.discord": "https://discord.gg/yRkqCvFcmz",
				"modmenu.additions.crowdin": "https://crowdin.com/project/dayofmind-additions",
				"modmenu.additions.github": "https://github.com/LufatZ/DOMAdditions/",
				"modmenu.additions.oxfatech": "https://oxfatech.de",
				"modmenu.additions.kofi": "https://ko-fi.com/oxfatech"
			},
			"update_checker": true
		}
	},
	"mixins": [
		"additions.mixins.json"
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "*",
		"java": "*",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}